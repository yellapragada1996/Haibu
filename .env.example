# =============================================================================
# Haibu Environment Variables
#
# Each external service needs SEPARATE instances for staging vs production.
# See the deployment guide below for setup instructions.
#
# Environments:
#   Local dev  → .env.local (copy this file)
#   Staging    → Vercel env vars, scope: Preview, branch: staging
#   Production → Vercel env vars, scope: Production
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase (database + auth) — SEPARATE PROJECT per environment
# ---------------------------------------------------------------------------
# Create two Supabase projects: one for staging, one for production.
# Use the "Session pooler" connection string from each project's dashboard.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"

# ---------------------------------------------------------------------------
# Stripe (payments) — USE TEST MODE for staging, LIVE MODE for production
# ---------------------------------------------------------------------------
# Staging: sk_test_..., pk_test_... (Stripe test mode — no real charges)
# Production: sk_live_..., pk_live_... (Stripe live mode — real money)
# Each environment needs its own webhook endpoint registered in Stripe.
STRIPE_SECRET_KEY="sk_test_[...]"
STRIPE_WEBHOOK_SECRET="whsec_[...]"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_[...]"

# ---------------------------------------------------------------------------
# Daily.co (video rooms) — same account is fine, rooms are namespaced by booking ID
# ---------------------------------------------------------------------------
DAILY_API_KEY="[API_KEY]"
DAILY_WEBHOOK_SECRET="[WEBHOOK_SECRET]"

# ---------------------------------------------------------------------------
# Inngest (background jobs) — SEPARATE environment per deployment
# ---------------------------------------------------------------------------
# Vercel integration auto-sets these per environment.
# For local dev, use the Inngest Dev Server (INNGEST_DEV=1).
INNGEST_EVENT_KEY="[EVENT_KEY]"
INNGEST_SIGNING_KEY="[SIGNING_KEY]"

# ---------------------------------------------------------------------------
# Resend (transactional email) — same API key is fine
# ---------------------------------------------------------------------------
# Staging emails go to the same mailboxes. Alternatively, set up a staging
# sender domain (e.g., mail.staging.haibu.live) to distinguish them.
RESEND_API_KEY="re_[...]"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Local: http://localhost:3000
# Staging: https://staging.haibu.live
# Production: https://haibu.live
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Double-blind review publish delay (ms). 48h in prod, 1min locally for testing.
REVIEW_PUBLISH_DELAY_MS=172800000
