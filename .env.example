# Database (Supabase PostgreSQL)
# Connection string for the Supabase PostgreSQL database.
# Use the "Session pooler" connection string from Supabase dashboard.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"

# Stripe Connect
STRIPE_SECRET_KEY="sk_live_[...]"
STRIPE_WEBHOOK_SECRET="whsec_[...]"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_[...]"
STRIPE_CONNECT_CLIENT_ID="ca_[...]"
STRIPE_IDENTITY_VERIFICATION_SECRET="whsec_identity_[...]"

# Daily.co
DAILY_API_KEY="[API_KEY]"
DAILY_WEBHOOK_SECRET="[WEBHOOK_SECRET]"

# Inngest
INNGEST_EVENT_KEY="[EVENT_KEY]"
INNGEST_SIGNING_KEY="[SIGNING_KEY]"

# Resend (Transactional Email)
RESEND_API_KEY="re_[...]"

# Cloudflare R2 (Media Storage)
R2_ACCESS_KEY_ID="[ACCESS_KEY]"
R2_SECRET_ACCESS_KEY="[SECRET_KEY]"
R2_ENDPOINT="https://[ACCOUNT_ID].r2.cloudflarestorage.com"
R2_BUCKET_NAME="haibu-media"
R2_PUBLIC_URL="https://[BUCKET].[ACCOUNT_ID].r2.dev"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Double-blind review publish delay (ms). 48h in prod, 1min locally for testing.
REVIEW_PUBLISH_DELAY_MS=172800000
